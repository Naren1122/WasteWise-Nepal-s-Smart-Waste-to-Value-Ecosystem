# WasteWise Backend Configuration
NODE_ENV=development
PORT=5000

# PostgreSQL + PostGIS Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wastewise_dev?schema=public"

# Redis Cache & BullMQ Queue
REDIS_URL="redis://localhost:6379"

# JWT Secrets & Expiration
JWT_ACCESS_SECRET="super-secret-jwt-access-key-minimum-32-chars-long"
JWT_REFRESH_SECRET="super-secret-jwt-refresh-key-minimum-32-chars-long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS Allowed Origins
CORS_ORIGIN="http://localhost:3000"

