datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  MUNICIPAL_ADMIN
  WARD_OFFICER
  DISPATCHER
  DRIVER
  FIELD_WORKER
  CITIZEN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  INSTITUTIONAL
}

enum PropertyStatus {
  PENDING_VERIFICATION
  ACTIVE
  INACTIVE
}

enum WasteType {
  ORGANIC
  RECYCLABLE
  HAZARDOUS
  BULKY
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum BulkyWasteStatus {
  SUBMITTED
  QUOTED
  APPROVED
  SCHEDULED
  COMPLETED
  REJECTED
  CANCELLED
}

enum PickupStatus {
  SCHEDULED
  COMPLETED
  MISSED
  CANCELLED
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  subdomain String   @unique @db.VarChar(50)
  province  String   @db.VarChar(50)
  district  String   @db.VarChar(50)
  logoUrl   String?  @map("logo_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  wards               Ward[]
  serviceZones        ServiceZone[]
  properties          Property[]
  users               User[]
  servicePlans        ServicePlan[]
  subscriptions       Subscription[]
  collectionSchedules CollectionSchedule[]
  scheduledPickups    ScheduledPickup[]
  bulkyWasteRequests  BulkyWasteRequest[]

  @@map("tenants")
}

model Ward {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  wardNumber    Int      @map("ward_number")
  officeAddress String?  @map("office_address") @db.VarChar(255)
  contactPhone  String?  @map("contact_phone") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users               User[]
  serviceZones        ServiceZone[]
  properties          Property[]
  collectionSchedules CollectionSchedule[]
  scheduledPickups    ScheduledPickup[]

  @@unique([id, tenantId])
  @@unique([tenantId, wardNumber])
  @@map("wards")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  wardId       String?    @map("ward_id") @db.Uuid
  fullName     String     @map("full_name") @db.VarChar(100)
  email        String     @db.VarChar(150)
  phone        String     @db.VarChar(20)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  role         Role       @default(CITIZEN)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ward               Ward?               @relation(fields: [wardId], references: [id], onDelete: SetNull)
  refreshTokens      RefreshToken[]
  properties         Property[]
  subscriptions      Subscription[]
  bulkyWasteRequests BulkyWasteRequest[]

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@unique([id, tenantId])
  @@index([tenantId, role])
  @@index([tenantId, wardId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  familyId  String   @map("family_id") @db.Uuid
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@map("refresh_tokens")
}

model ServiceZone {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  wardId      String   @map("ward_id") @db.Uuid
  name        String   @db.VarChar(100)
  code        String   @db.VarChar(50)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ward                Ward                 @relation(fields: [wardId], references: [id], onDelete: Cascade)
  properties          Property[]
  collectionSchedules CollectionSchedule[]

  @@unique([id, tenantId])
  @@unique([tenantId, wardId, code])
  @@map("service_zones")
}

model Property {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  wardId        String         @map("ward_id") @db.Uuid
  zoneId        String?        @map("zone_id") @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  propertyType  PropertyType   @default(RESIDENTIAL) @map("property_type")
  status        PropertyStatus @default(PENDING_VERIFICATION)
  houseNumber   String?        @map("house_number") @db.VarChar(50)
  streetAddress String         @map("street_address") @db.VarChar(255)
  latitude      Float
  longitude     Float
  qrCode        String?        @unique @map("qr_code") @db.VarChar(100)
  contactName   String         @map("contact_name") @db.VarChar(100)
  contactPhone  String         @map("contact_phone") @db.VarChar(20)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ward               Ward                @relation(fields: [wardId, tenantId], references: [id, tenantId], onDelete: Restrict)
  zone               ServiceZone?        @relation(fields: [zoneId, tenantId], references: [id, tenantId], onDelete: Restrict)
  owner              User                @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Restrict)
  subscriptions      Subscription[]
  scheduledPickups   ScheduledPickup[]
  bulkyWasteRequests BulkyWasteRequest[]

  @@unique([id, tenantId])
  @@index([tenantId, wardId])
  @@index([tenantId, zoneId])
  @@index([tenantId, userId])
  @@index([tenantId, status])
  @@map("properties")
}

model ServicePlan {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  name           String       @db.VarChar(100)
  code           String       @db.VarChar(50)
  description    String?      @db.VarChar(255)
  propertyType   PropertyType @default(RESIDENTIAL) @map("property_type")
  wasteType      WasteType    @default(ORGANIC) @map("waste_type")
  monthlyRateNpr Float        @map("monthly_rate_npr")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@unique([id, tenantId])
  @@unique([tenantId, code])
  @@index([tenantId, propertyType])
  @@index([tenantId, isActive])
  @@map("service_plans")
}

model Subscription {
  id         String             @id @default(uuid()) @db.Uuid
  tenantId   String             @map("tenant_id") @db.Uuid
  propertyId String             @map("property_id") @db.Uuid
  planId     String             @map("plan_id") @db.Uuid
  userId     String             @map("user_id") @db.Uuid
  status     SubscriptionStatus @default(ACTIVE)
  startDate  DateTime           @default(now()) @map("start_date")
  endDate    DateTime?          @map("end_date")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property    @relation(fields: [propertyId, tenantId], references: [id, tenantId], onDelete: Cascade)
  plan     ServicePlan @relation(fields: [planId, tenantId], references: [id, tenantId], onDelete: Restrict)
  user     User        @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, propertyId])
  @@index([tenantId, userId])
  @@index([tenantId, status])
  @@map("subscriptions")
}

model CollectionSchedule {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  wardId    String    @map("ward_id") @db.Uuid
  zoneId    String?   @map("zone_id") @db.Uuid
  wasteType WasteType @map("waste_type")
  dayOfWeek Int       @map("day_of_week")
  startTime String    @map("start_time") @db.VarChar(10)
  endTime   String    @map("end_time") @db.VarChar(10)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ward             Ward              @relation(fields: [wardId, tenantId], references: [id, tenantId], onDelete: Cascade)
  zone             ServiceZone?      @relation(fields: [zoneId, tenantId], references: [id, tenantId], onDelete: SetNull)
  scheduledPickups ScheduledPickup[]

  @@unique([id, tenantId])
  @@index([tenantId, wardId, dayOfWeek])
  @@index([tenantId, isActive])
  @@map("collection_schedules")
}

model ScheduledPickup {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  wardId     String       @map("ward_id") @db.Uuid
  propertyId String?      @map("property_id") @db.Uuid
  scheduleId String?      @map("schedule_id") @db.Uuid
  pickupDate DateTime     @map("pickup_date") @db.Date
  wasteType  WasteType    @map("waste_type")
  status     PickupStatus @default(SCHEDULED)
  notes      String?      @db.VarChar(255)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ward     Ward                @relation(fields: [wardId, tenantId], references: [id, tenantId], onDelete: Cascade)
  property Property?           @relation(fields: [propertyId, tenantId], references: [id, tenantId], onDelete: SetNull)
  schedule CollectionSchedule? @relation(fields: [scheduleId, tenantId], references: [id, tenantId], onDelete: SetNull)

  @@unique([id, tenantId])
  @@index([tenantId, wardId, pickupDate])
  @@index([tenantId, status])
  @@map("scheduled_pickups")
}

model BulkyWasteRequest {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  propertyId      String           @map("property_id") @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  itemDescription String           @map("item_description") @db.VarChar(500)
  estimatedVolume String?          @map("estimated_volume") @db.VarChar(100)
  preferredDate   DateTime         @map("preferred_date") @db.Date
  scheduledDate   DateTime?        @map("scheduled_date") @db.Date
  status          BulkyWasteStatus @default(SUBMITTED)
  quotedAmountNpr Decimal?         @map("quoted_amount_npr") @db.Decimal(10, 2)
  officerNotes    String?          @map("officer_notes") @db.VarChar(500)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId, tenantId], references: [id, tenantId], onDelete: Cascade)
  user     User     @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, propertyId])
  @@index([tenantId, userId])
  @@index([tenantId, status])
  @@map("bulky_waste_requests")
}
