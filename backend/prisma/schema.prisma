datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  MUNICIPAL_ADMIN
  WARD_OFFICER
  DISPATCHER
  DRIVER
  FIELD_WORKER
  CITIZEN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  INSTITUTIONAL
}

enum PropertyStatus {
  PENDING_VERIFICATION
  ACTIVE
  INACTIVE
}

enum WasteType {
  ORGANIC
  RECYCLABLE
  HAZARDOUS
  BULKY
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum BulkyWasteStatus {
  SUBMITTED
  QUOTED
  APPROVED
  SCHEDULED
  COMPLETED
  REJECTED
  CANCELLED
}

enum PickupStatus {
  SCHEDULED
  COMPLETED
  MISSED
  CANCELLED
}

enum VehicleType {
  COMPACTOR
  TIPPER
  TRUCK
  TRACTOR
  ELECTRIC_CART
}

enum VehicleStatus {
  AVAILABLE
  ON_ROUTE
  MAINTENANCE
  RETIRED
}

enum RouteStatus {
  DRAFT
  DISPATCHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum StopStatus {
  PENDING
  COLLECTED
  PARTIAL
  MISSED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentGateway {
  ESEWA
  KHALTI
  CASH_COUNTER
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  EXPIRED
  REFUNDED
}

enum InvoiceItemType {
  SUBSCRIPTION_FEE
  BULKY_WASTE_FEE
  PENALTY_SURCHARGE
  ADJUSTMENT
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  subdomain String   @unique @db.VarChar(50)
  province  String   @db.VarChar(50)
  district  String   @db.VarChar(50)
  logoUrl   String?  @map("logo_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  wards               Ward[]
  serviceZones        ServiceZone[]
  properties          Property[]
  users               User[]
  servicePlans        ServicePlan[]
  subscriptions       Subscription[]
  collectionSchedules CollectionSchedule[]
  scheduledPickups    ScheduledPickup[]
  bulkyWasteRequests  BulkyWasteRequest[]
  vehicles            Vehicle[]
  routes              Route[]
  routeStops          RouteStop[]
  vehicleLocations    VehicleLocation[]
  invoices            Invoice[]
  invoiceItems        InvoiceItem[]
  payments            Payment[]

  @@map("tenants")
}

model Ward {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  wardNumber    Int      @map("ward_number")
  officeAddress String?  @map("office_address") @db.VarChar(255)
  contactPhone  String?  @map("contact_phone") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users               User[]
  serviceZones        ServiceZone[]
  properties          Property[]
  collectionSchedules CollectionSchedule[]
  scheduledPickups    ScheduledPickup[]
  routes              Route[]

  @@unique([id, tenantId])
  @@unique([tenantId, wardNumber])
  @@map("wards")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  wardId       String?    @map("ward_id") @db.Uuid
  fullName     String     @map("full_name") @db.VarChar(100)
  email        String     @db.VarChar(150)
  phone        String     @db.VarChar(20)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  role         Role       @default(CITIZEN)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ward               Ward?               @relation(fields: [wardId], references: [id], onDelete: SetNull)
  refreshTokens      RefreshToken[]
  properties         Property[]
  subscriptions      Subscription[]
  bulkyWasteRequests BulkyWasteRequest[]
  vehiclesDriven     Vehicle[]           @relation("VehicleDriver")
  routesDriven       Route[]             @relation("RouteDriver")
  invoices           Invoice[]
  paymentsMade       Payment[]           @relation("PayerRelation")
  paymentsCollected  Payment[]           @relation("CashierRelation")

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@unique([id, tenantId])
  
  @@index([tenantId, role])
  @@index([tenantId, wardId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  familyId  String   @map("family_id") @db.Uuid
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@map("refresh_tokens")
}

model ServiceZone {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  wardId      String   @map("ward_id") @db.Uuid
  name        String   @db.VarChar(100)
  code        String   @db.VarChar(50)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ward                Ward                 @relation(fields: [wardId], references: [id], onDelete: Cascade)
  properties          Property[]
  collectionSchedules CollectionSchedule[]
  routes              Route[]

  @@unique([id, tenantId])
  @@unique([tenantId, wardId, code])
  @@map("service_zones")
}

model Property {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  wardId        String         @map("ward_id") @db.Uuid
  zoneId        String?        @map("zone_id") @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  propertyType  PropertyType   @default(RESIDENTIAL) @map("property_type")
  status        PropertyStatus @default(PENDING_VERIFICATION)
  houseNumber   String?        @map("house_number") @db.VarChar(50)
  streetAddress String         @map("street_address") @db.VarChar(255)
  latitude      Float
  longitude     Float
  qrCode        String?        @unique @map("qr_code") @db.VarChar(100)
  contactName   String         @map("contact_name") @db.VarChar(100)
  contactPhone  String         @map("contact_phone") @db.VarChar(20)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ward               Ward                @relation(fields: [wardId, tenantId], references: [id, tenantId], onDelete: Restrict)
  zone               ServiceZone?        @relation(fields: [zoneId, tenantId], references: [id, tenantId], onDelete: Restrict)
  owner              User                @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Restrict)
  subscriptions      Subscription[]
  scheduledPickups   ScheduledPickup[]
  bulkyWasteRequests BulkyWasteRequest[]
  routeStops         RouteStop[]
  invoices           Invoice[]

  @@unique([id, tenantId])
  @@index([tenantId, wardId])
  @@index([tenantId, zoneId])
  @@index([tenantId, userId])
  @@index([tenantId, status])
  @@map("properties")
}

model ServicePlan {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  name           String       @db.VarChar(100)
  code           String       @db.VarChar(50)
  description    String?      @db.VarChar(255)
  propertyType   PropertyType @default(RESIDENTIAL) @map("property_type")
  wasteType      WasteType    @default(ORGANIC) @map("waste_type")
  monthlyRateNpr Float        @map("monthly_rate_npr")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@unique([id, tenantId])
  @@unique([tenantId, code])
  @@index([tenantId, propertyType])
  @@index([tenantId, isActive])
  @@map("service_plans")
}

model Subscription {
  id         String             @id @default(uuid()) @db.Uuid
  tenantId   String             @map("tenant_id") @db.Uuid
  propertyId String             @map("property_id") @db.Uuid
  planId     String             @map("plan_id") @db.Uuid
  userId     String             @map("user_id") @db.Uuid
  status     SubscriptionStatus @default(ACTIVE)
  startDate  DateTime           @default(now()) @map("start_date")
  endDate    DateTime?          @map("end_date")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property    @relation(fields: [propertyId, tenantId], references: [id, tenantId], onDelete: Cascade)
  plan     ServicePlan @relation(fields: [planId, tenantId], references: [id, tenantId], onDelete: Restrict)
  user     User        @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Restrict)
  invoices Invoice[]

  @@unique([id, tenantId])
  @@index([tenantId, propertyId])
  @@index([tenantId, userId])
  @@index([tenantId, status])
  @@map("subscriptions")
}

model CollectionSchedule {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  wardId    String    @map("ward_id") @db.Uuid
  zoneId    String?   @map("zone_id") @db.Uuid
  wasteType WasteType @map("waste_type")
  dayOfWeek Int       @map("day_of_week")
  startTime String    @map("start_time") @db.VarChar(10)
  endTime   String    @map("end_time") @db.VarChar(10)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ward             Ward              @relation(fields: [wardId, tenantId], references: [id, tenantId], onDelete: Cascade)
  zone             ServiceZone?      @relation(fields: [zoneId, tenantId], references: [id, tenantId], onDelete: SetNull)
  scheduledPickups ScheduledPickup[]

  @@unique([id, tenantId])
  @@index([tenantId, wardId, dayOfWeek])
  @@index([tenantId, isActive])
  @@map("collection_schedules")
}

model ScheduledPickup {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  wardId     String       @map("ward_id") @db.Uuid
  propertyId String?      @map("property_id") @db.Uuid
  scheduleId String?      @map("schedule_id") @db.Uuid
  pickupDate DateTime     @map("pickup_date") @db.Date
  wasteType  WasteType    @map("waste_type")
  status     PickupStatus @default(SCHEDULED)
  notes      String?      @db.VarChar(255)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ward     Ward                @relation(fields: [wardId, tenantId], references: [id, tenantId], onDelete: Cascade)
  property Property?           @relation(fields: [propertyId, tenantId], references: [id, tenantId], onDelete: SetNull)
  schedule CollectionSchedule? @relation(fields: [scheduleId, tenantId], references: [id, tenantId], onDelete: SetNull)

  @@unique([id, tenantId])
  @@index([tenantId, wardId, pickupDate])
  @@index([tenantId, status])
  @@map("scheduled_pickups")
}

model BulkyWasteRequest {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  propertyId      String           @map("property_id") @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  itemDescription String           @map("item_description") @db.VarChar(500)
  estimatedVolume String?          @map("estimated_volume") @db.VarChar(100)
  preferredDate   DateTime         @map("preferred_date") @db.Date
  scheduledDate   DateTime?        @map("scheduled_date") @db.Date
  status          BulkyWasteStatus @default(SUBMITTED)
  quotedAmountNpr Float?           @map("quoted_amount_npr")
  officerNotes    String?          @map("officer_notes") @db.VarChar(500)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property   Property    @relation(fields: [propertyId, tenantId], references: [id, tenantId], onDelete: Cascade)
  user       User        @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Restrict)
  routeStops RouteStop[]
  invoices   Invoice[]

  @@unique([id, tenantId])
  @@index([tenantId, propertyId])
  @@index([tenantId, userId])
  @@index([tenantId, status])
  @@map("bulky_waste_requests")
}

model Vehicle {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  registrationNo   String        @map("registration_no") @db.VarChar(50)
  vehicleType      VehicleType   @map("vehicle_type")
  capacityKg       Float         @map("capacity_kg")
  fuelType         String?       @map("fuel_type") @db.VarChar(30)
  status           VehicleStatus @default(AVAILABLE)
  assignedDriverId String?       @map("assigned_driver_id") @db.Uuid
  notes            String?       @db.VarChar(255)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  tenant         Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedDriver User?   @relation("VehicleDriver", fields: [assignedDriverId, tenantId], references: [id, tenantId], onDelete: SetNull)
  routes         Route[]
  locations      VehicleLocation[]

  @@unique([id, tenantId])
  @@unique([tenantId, registrationNo])
  @@index([tenantId, status])
  @@map("vehicles")
}

model Route {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @map("tenant_id") @db.Uuid
  wardId    String      @map("ward_id") @db.Uuid
  zoneId    String?     @map("zone_id") @db.Uuid
  vehicleId String?     @map("vehicle_id") @db.Uuid
  driverId  String?     @map("driver_id") @db.Uuid
  routeDate DateTime    @map("route_date") @db.Date
  wasteType WasteType   @map("waste_type")
  status    RouteStatus @default(DRAFT)
  startTime DateTime?   @map("start_time")
  endTime   DateTime?   @map("end_time")
  notes     String?     @db.VarChar(500)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ward    Ward         @relation(fields: [wardId, tenantId], references: [id, tenantId], onDelete: Cascade)
  zone    ServiceZone? @relation(fields: [zoneId, tenantId], references: [id, tenantId], onDelete: SetNull)
  vehicle Vehicle?     @relation(fields: [vehicleId, tenantId], references: [id, tenantId], onDelete: SetNull)
  driver  User?        @relation("RouteDriver", fields: [driverId, tenantId], references: [id, tenantId], onDelete: SetNull)
  stops     RouteStop[]
  locations VehicleLocation[]

  @@unique([id, tenantId])
  @@index([tenantId, wardId, routeDate])
  @@index([tenantId, status])
  @@index([tenantId, driverId])
  @@map("routes")
}

model RouteStop {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  routeId        String            @map("route_id") @db.Uuid
  sequenceOrder  Int               @map("sequence_order")
  propertyId     String?           @map("property_id") @db.Uuid
  bulkyRequestId String?           @map("bulky_request_id") @db.Uuid
  status         StopStatus        @default(PENDING)
  failureReason  String?           @map("failure_reason") @db.VarChar(255)
  proofPhotoUrl  String?           @map("proof_photo_url") @db.VarChar(500)
  latitude       Float?
  longitude      Float?
  completedAt    DateTime?         @map("completed_at")
  notes          String?           @db.VarChar(255)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  route        Route              @relation(fields: [routeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  property     Property?          @relation(fields: [propertyId, tenantId], references: [id, tenantId], onDelete: SetNull)
  bulkyRequest BulkyWasteRequest? @relation(fields: [bulkyRequestId, tenantId], references: [id, tenantId], onDelete: SetNull)

  @@unique([id, tenantId])
  @@index([tenantId, routeId, sequenceOrder])
  @@index([tenantId, status])
  @@map("route_stops")
}

model VehicleLocation {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  vehicleId  String   @map("vehicle_id") @db.Uuid
  routeId    String?  @map("route_id") @db.Uuid
  driverId   String?  @map("driver_id") @db.Uuid
  latitude   Float
  longitude  Float
  speedKmh   Float?   @map("speed_kmh")
  headingDeg Float?   @map("heading_deg")
  recordedAt DateTime @default(now()) @map("recorded_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle Vehicle  @relation(fields: [vehicleId, tenantId], references: [id, tenantId], onDelete: Cascade)
  route   Route?   @relation(fields: [routeId, tenantId], references: [id, tenantId], onDelete: SetNull)

  @@unique([id, tenantId])
  @@unique([tenantId, vehicleId, recordedAt])
  @@index([tenantId, vehicleId, recordedAt(sort: Desc)])
  @@index([tenantId, routeId, recordedAt(sort: Desc)])
  @@index([recordedAt])
  @@map("vehicle_locations")
}

model Invoice {
  id                  String        @id @default(uuid()) @db.Uuid
  tenantId            String        @map("tenant_id") @db.Uuid
  citizenId           String        @map("citizen_id") @db.Uuid
  propertyId          String        @map("property_id") @db.Uuid
  subscriptionId      String?       @map("subscription_id") @db.Uuid
  bulkyWasteRequestId String?       @map("bulky_waste_request_id") @db.Uuid
  
  invoiceNumber       String        @map("invoice_number") @db.VarChar(50)
  billingMonth        Int           @map("billing_month")
  billingYear         Int           @map("billing_year")
  
  subtotalAmount      Decimal       @map("subtotal_amount") @db.Decimal(12, 2)
  discountAmount      Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount           Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount         Decimal       @map("total_amount") @db.Decimal(12, 2)
  
  status              InvoiceStatus @default(ISSUED)
  dueDate             DateTime      @map("due_date")
  paidAt              DateTime?     @map("paid_at")
  notes               String?       @db.Text
  
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  citizen             User               @relation(fields: [citizenId], references: [id], onDelete: Restrict)
  property            Property           @relation(fields: [propertyId, tenantId], references: [id, tenantId], onDelete: Cascade)
  subscription        Subscription?      @relation(fields: [subscriptionId, tenantId], references: [id, tenantId], onDelete: SetNull)
  bulkyWasteRequest   BulkyWasteRequest? @relation(fields: [bulkyWasteRequestId, tenantId], references: [id, tenantId], onDelete: SetNull)
  
  items               InvoiceItem[]
  payments            Payment[]

  @@unique([id, tenantId])
  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, citizenId, status])
  @@index([tenantId, propertyId])
  @@index([tenantId, status, dueDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  invoiceId   String          @map("invoice_id") @db.Uuid
  itemType    InvoiceItemType @default(SUBSCRIPTION_FEE) @map("item_type")
  description String          @db.VarChar(255)
  quantity    Int             @default(1)
  unitPrice   Decimal         @map("unit_price") @db.Decimal(12, 2)
  totalPrice  Decimal         @map("total_price") @db.Decimal(12, 2)
  createdAt   DateTime        @default(now()) @map("created_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice     Invoice  @relation(fields: [invoiceId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId, invoiceId])
  @@map("invoice_items")
}

model Payment {
  id                   String         @id @default(uuid()) @db.Uuid
  tenantId             String         @map("tenant_id") @db.Uuid
  invoiceId            String         @map("invoice_id") @db.Uuid
  payerId              String         @map("payer_id") @db.Uuid
  collectedByUserId    String?        @map("collected_by_user_id") @db.Uuid
  
  paymentGateway       PaymentGateway @map("payment_gateway")
  status               PaymentStatus  @default(INITIATED)
  amount               Decimal        @db.Decimal(12, 2)
  currency             String         @default("NPR") @db.VarChar(3)
  
  transactionReference String         @map("transaction_reference") @db.VarChar(100)
  gatewayRefId         String?        @map("gateway_ref_id") @db.VarChar(150)
  gatewayResponse      Json?          @map("gateway_response")
  
  receiptNumber        String?        @map("receipt_number") @db.VarChar(50)
  paidAt               DateTime?      @map("paid_at")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice              Invoice  @relation(fields: [invoiceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  payer                User     @relation(name: "PayerRelation", fields: [payerId], references: [id], onDelete: Restrict)
  collectedBy          User?    @relation(name: "CashierRelation", fields: [collectedByUserId], references: [id], onDelete: SetNull)

  @@unique([id, tenantId])
  @@unique([tenantId, transactionReference])
  @@index([tenantId, gatewayRefId])
  @@index([tenantId, invoiceId, status])
  @@index([tenantId, payerId])
  @@map("payments")
}
