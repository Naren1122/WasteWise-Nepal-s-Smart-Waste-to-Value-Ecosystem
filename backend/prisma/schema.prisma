datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  MUNICIPAL_ADMIN
  WARD_OFFICER
  DISPATCHER
  DRIVER
  FIELD_WORKER
  CITIZEN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  INSTITUTIONAL
}

enum PropertyStatus {
  PENDING_VERIFICATION
  ACTIVE
  INACTIVE
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  subdomain String   @unique @db.VarChar(50)
  province  String   @db.VarChar(50)
  district  String   @db.VarChar(50)
  logoUrl   String?  @map("logo_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  wards         Ward[]
  serviceZones  ServiceZone[]
  properties    Property[]
  users         User[]

  @@map("tenants")
}

model Ward {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  wardNumber    Int      @map("ward_number")
  officeAddress String?  @map("office_address") @db.VarChar(255)
  contactPhone  String?  @map("contact_phone") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users        User[]
  serviceZones ServiceZone[]
  properties   Property[]

  @@unique([id, tenantId])
  @@unique([tenantId, wardNumber])
  @@map("wards")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  wardId       String?    @map("ward_id") @db.Uuid
  fullName     String     @map("full_name") @db.VarChar(100)
  email        String     @db.VarChar(150)
  phone        String     @db.VarChar(20)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  role         Role       @default(CITIZEN)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ward          Ward?          @relation(fields: [wardId], references: [id], onDelete: SetNull)
  refreshTokens RefreshToken[]
  properties    Property[]

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@unique([id, tenantId])
  @@index([tenantId, role])
  @@index([tenantId, wardId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  familyId  String   @map("family_id") @db.Uuid
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@map("refresh_tokens")
}

model ServiceZone {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  wardId      String   @map("ward_id") @db.Uuid
  name        String   @db.VarChar(100)
  code        String   @db.VarChar(50)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ward       Ward       @relation(fields: [wardId], references: [id], onDelete: Cascade)
  properties Property[]

  @@unique([id, tenantId])
  @@unique([tenantId, wardId, code])
  @@map("service_zones")
}

model Property {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  wardId          String         @map("ward_id") @db.Uuid
  zoneId          String?        @map("zone_id") @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  propertyType    PropertyType   @default(RESIDENTIAL) @map("property_type")
  status          PropertyStatus @default(PENDING_VERIFICATION)
  houseNumber     String?        @map("house_number") @db.VarChar(50)
  streetAddress   String         @map("street_address") @db.VarChar(255)
  latitude        Float
  longitude       Float
  qrCode          String?        @unique @map("qr_code") @db.VarChar(100)
  contactName     String         @map("contact_name") @db.VarChar(100)
  contactPhone    String         @map("contact_phone") @db.VarChar(20)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ward   Ward         @relation(fields: [wardId, tenantId], references: [id, tenantId], onDelete: Restrict)
  zone   ServiceZone? @relation(fields: [zoneId, tenantId], references: [id, tenantId], onDelete: Restrict)
  owner  User         @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([tenantId, wardId])
  @@index([tenantId, zoneId])
  @@index([tenantId, userId])
  @@index([tenantId, status])
  @@map("properties")
}

